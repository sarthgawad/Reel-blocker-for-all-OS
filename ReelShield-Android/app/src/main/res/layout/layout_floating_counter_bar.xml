<?xml version="1.0" encoding="utf-8"?>
<!-- Floating Rectangular Bar Layout rendered via WindowManager on Android -->
<!-- User requirement: Small number with circular border rectangular bar + Made by Sarth -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingRootBar"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pill_bar"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="4dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp">

    <!-- Drag indicator -->
    <TextView
        android:id="@+id/tvDragHandle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="⋮⋮"
        android:textColor="@color/text_muted"
        android:textSize="14sp" />

    <!-- Shield Icon -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:text="🛡️"
        android:textSize="14sp" />

    <!-- Label -->
    <TextView
        android:id="@+id/tvBarLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:text="Reels:"
        android:textColor="#CBD5E1"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- The Small Number with Circular Border (User requested feature) -->
    <FrameLayout
        android:id="@+id/flFloatingBadge"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_circle_badge">

        <TextView
            android:id="@+id/tvFloatingCount"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="0"
            android:textColor="@color/text_white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Platform breakdown tags -->
    <LinearLayout
        android:id="@+id/llBreakdownTags"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvYtTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="YT:0 "
            android:textColor="@color/color_red"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIgTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="IG:0 "
            android:textColor="@color/color_ig"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFbTag"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FB:0"
            android:textColor="@color/color_fb"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Attractive Made by Sarth small tag -->
    <TextView
        android:id="@+id/tvAuthorTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_pill_bar"
        android:paddingStart="6dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:text="by Sarth"
        android:textColor="#C084FC"
        android:textSize="9sp"
        android:textStyle="bold" />

</LinearLayout>
