<?xml version="1.0" encoding="utf-8"?>
<!-- Rectangular Bar with Circular Border Ends (Pill shape) -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#F00F172A" />
    <corners android:radius="999dp" />
    <stroke
        android:width="1.5dp"
        android:color="#4D6366F1" />
    <padding
        android:left="12dp"
        android:top="6dp"
        android:right="14dp"
        android:bottom="6dp" />
</shape>
