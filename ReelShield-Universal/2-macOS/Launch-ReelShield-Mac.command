#!/bin/bash
echo "========================================================"
echo "      Starting ReelShield for macOS by Sarth"
echo "========================================================"
echo ""
echo "Opening ReelShield Interactive Hub & Simulator..."
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
open "$DIR/index.html"
echo ""
echo "To install as extension in Chrome, Edge, Brave, or Safari:"
echo "1. In Chrome/Brave/Edge: Go to chrome://extensions"
echo "2. Enable Developer Mode"
echo "3. Click 'Load unpacked' and select this folder."
echo ""
